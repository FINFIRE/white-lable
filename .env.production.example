# Copy to .env on the EC2 box and fill in real values.
# Never commit the real .env.

DEBUG=False
SECRET_KEY=replace-with-a-long-random-string

# RDS Postgres endpoint (no protocol, no slash).
POSTGRES_DB=finfire
POSTGRES_USER=finfire
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=finfire-prod.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432

# These keys are read by docker-compose.prod.yml for the variable expansion
# in the volume mounts at the host side. They are NOT used by Django in prod
# (production.py pins STATIC_ROOT/MEDIA_ROOT to absolute /app paths inside
# the container). Leave them set so `docker compose config` doesn't warn.
MEDIA_ROOT=/var/www/finfire/media
STATIC_ROOT=/var/www/finfire/static

# Gmail app password or whatever SMTP you use.
EMAIL_HOST_USER=ops@appfinfire.com
EMAIL_HOST_PASSWORD=replace-me

HOST_ENV=production
DOMAIN=appfinfire.com

# Default URL embedded in activation/reset emails when there is no tenant
# context. Per-tenant URLs are built from the tenant's domain at request time.
FRONTEND_BASE_URL=https://appfinfire.com

# Stripe LIVE keys (rotate the test keys out of source control too).
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
# Pull from Stripe dashboard → Developers → Webhooks → Signing secret
# AFTER you point the webhook at https://appfinfire.com/api/subscriptions/webhook/
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_TRIAL_DAYS=7
